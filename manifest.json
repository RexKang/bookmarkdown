{
  "manifest_version": 3,
  "name": "BookmarkDown",
  "version": "0.1.0",
  "description": "本地优先的视频收藏海报墙：右键一键收藏，数据是你磁盘上的 Markdown 条目 + 封面快照",
  "minimum_chrome_version": "122",
  "permissions": ["contextMenus", "activeTab", "scripting", "storage"],
  "background": { "service_worker": "src/background/service-worker.js", "type": "module" },
  "action": { "default_title": "BookmarkDown", "default_popup": "src/popup/popup.html" }
}
